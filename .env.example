# 本地默认值即 docker-compose 中的 db 服务;线上(Supabase)替换为其连接串
DATABASE_URL=postgres://polyorders:polyorders@localhost:5432/polyorders
# Telegram 登录(BotFather 创建 bot 后填写;/setdomain 需设为站点域名)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 会话签名密钥(openssl rand -hex 32)
AUTH_SECRET=
# 允许登录的 Telegram 数字 ID,逗号分隔
TELEGRAM_ALLOWED_IDS=
