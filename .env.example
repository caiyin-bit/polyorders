# 本地默认值即 docker-compose 中的 db 服务;线上(Supabase)替换为其连接串
DATABASE_URL=postgres://polyorders:polyorders@localhost:5432/polyorders
# Telegram 登录(BotFather 创建 bot 后填写;/setdomain 需设为站点域名)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 会话签名密钥(openssl rand -hex 32)
AUTH_SECRET=
# 允许登录的 Telegram 数字 ID,逗号分隔
TELEGRAM_ALLOWED_IDS=
# 抓取失败与交易异常的告警接收者(Telegram chat id);也是门禁码审批的接收者
TELEGRAM_ALERT_CHAT_ID=
# 门禁码审批按钮的 webhook 密钥(openssl rand -hex 16);配好后跑 pnpm telegram:webhook set
TELEGRAM_WEBHOOK_SECRET=
# 站点公开地址,注册 webhook 时用
PUBLIC_ORIGIN=https://polyorders.bluesignals.cc

# ── 实时 watcher ──────────────────────────────────────────
# RTDS 地址,留空用官方 wss://ws-live-data.polymarket.com(仅测试重连时才需覆盖)
RTDS_URL=
# 关注池成交告警的金额门槛(美元),留空用 src/config.ts 默认值
WATCH_ALERT_MIN_USD=

# ── 交易(Polymarket CLOB V2)────────────────────────────────
# 下单签名用的 EOA 私钥(0x 开头)。持仓与资金主体是它派生出的 Deposit Wallet
POLYMARKET_PRIVATE_KEY=
# 留空则用 signer 派生的 Deposit Wallet;填写则以指定钱包为资金主体
POLYMARKET_WALLET_ADDRESS=
# 可选:polymarket.com/settings?tab=builder 取得的 relayer 凭据
POLYMARKET_RELAYER_KEY=
POLYMARKET_RELAYER_ADDRESS=
# 必须显式等于 true 才会真正发单,其余任何值(含留空)一律 dry-run
TRADING_ENABLED=
# 风控限额(美元),留空则用 src/config.ts 中的保守默认值
TRADE_MAX_USD=
TRADE_DAILY_MAX_USD=

# ── LLM 网关 ─────────────────────────────────────────────
# 主力模型走 DeepSeek 直连(platform.deepseek.com);留空则 LLM 功能整体停用
DEEPSEEK_API_KEY=
# 可选:OpenRouter 聚合密钥(openrouter.ai),配了才能用 claude-sonnet 等长尾模型
OPENROUTER_API_KEY=
# 默认逻辑模型,留空用 src/config.ts 注册表默认(deepseek-v4-flash)
LLM_MODEL=
# LLM 日预算(美元,北京时间自然日),留空用保守默认 $2;超限所有调用直接拒绝
LLM_DAILY_MAX_USD=

# ── 跟单引擎 ──────────────────────────────────────────────
# 默认 shadow(只记录不下单)。实盘跟单需本项与 TRADING_ENABLED 同时为 true
COPY_TRADING_ENABLED=
# 跟单专属日预算(美元),独立于且应低于 TRADE_DAILY_MAX_USD;留空用默认 $10
COPY_DAILY_MAX_USD=
