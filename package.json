{
  "name": "polyorders",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "fetch": "tsx src/fetch/index.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "watch:rtds": "tsx --env-file-if-exists=.env scripts/watch-rtds.ts",
    "orders:poll": "tsx --env-file-if-exists=.env scripts/orders-poll.ts",
    "wallet:doctor": "tsx --env-file-if-exists=.env scripts/wallet-doctor.ts",
    "wallet:setup": "tsx --env-file-if-exists=.env scripts/wallet-setup.ts",
    "telegram:webhook": "tsx --env-file-if-exists=.env scripts/telegram-webhook.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\" \"app/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@polymarket/client": "^0.3.0",
    "jose": "^6.2.8",
    "next": "^16.2.12",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3"
  }
}
